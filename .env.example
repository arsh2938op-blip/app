# PORT=8787
# HOST=0.0.0.0

# Token the browser must present on the app WebSocket.
# A random one is generated per boot if unset.
# WALLE_APP_TOKEN=change-me

# Shared secret the ESP32 requires in its WebSocket handshake.
# Sent as: Authorization: Bearer <token>
# WALLE_ROBOT_TOKEN=

# Gemini API key. Held by this server only — never bundled into the client
# and never sent to the ESP32. Without it the app answers from a small
# offline reply set so demos still work.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Connect to this robot on startup without waiting for mDNS.
# WALLE_ROBOT_HOST=192.168.1.42

# Start in demo mode (simulated robot, no hardware).
# WALLE_DEMO=0

# WALLE_DISCOVERY=1
# WALLE_DISCOVERY_TIMEOUT_MS=4000
# WALLE_RECONNECT=1
# WALLE_RECONNECT_MIN_MS=500
# WALLE_RECONNECT_MAX_MS=10000
# WALLE_REQUEST_TIMEOUT_MS=5000
# WALLE_RATE_WINDOW_MS=1000
# WALLE_RATE_MAX=25
# WALLE_MOTOR_SPEED=0.6
# WALLE_VOLUME=0.7

# Standalone mock robot (npm run mock)
# MOCK_PORT=8080
# MOCK_ADVERTISE=0
