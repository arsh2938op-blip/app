# PORT=8787
# HOST=0.0.0.0

# Token the browser must present on the app WebSocket.
# A random one is generated per boot if unset.
# WALLE_APP_TOKEN=change-me

# The robot's IP, from its serial log at boot. WALL-E does not advertise
# itself over mDNS, so there is nothing to discover.
# WALLE_ROBOT_HOST=192.168.1.42

# Must match APP_TCP_PORT in the firmware's include/config.h.
# WALLE_ROBOT_PORT=8080

# Optional bearer secret. The current firmware has no handshake, so this is
# only for a future build that adds one.
# WALLE_ROBOT_TOKEN=

# Start in demo mode with the simulated robot.
# WALLE_DEMO=0

# WALLE_RECONNECT=1
# WALLE_RECONNECT_MIN_MS=500
# WALLE_RECONNECT_MAX_MS=10000
# WALLE_RATE_WINDOW_MS=1000
# WALLE_RATE_MAX=60

# Standalone simulator (npm run mock)
# MOCK_PORT=8080
# Rehearse a cliff refusal on stage: MOCK_CLIFF=3
# MOCK_CLIFF=0
